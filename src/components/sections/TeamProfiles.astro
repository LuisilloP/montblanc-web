---
import { Image } from 'astro:assets';
import { resolveImage } from '../../libs/images';

type Doctor = {
  name: string;
  badge: string;
  subtitle: string;
  experienceYears: string;
  tags: string[];
  bullets: string[];
  photo: string;
};

type Props = {
  data: {
    eyebrow: string;
    title: string;
    description: string;
    experienceLabel: string;
    experienceSuffix: string;
    doctors: Doctor[];
  };
};

const { data } = Astro.props as Props;
const doctors = (data?.doctors ?? []).map((doctor) => ({
  doctor,
  asset: resolveImage(doctor.photo),
}));
---

<section
  id="sobre"
  class="section-rhythm relative overflow-hidden"
  data-reveal
>
  <div class="pointer-events-none absolute inset-0 opacity-75">
    <div class="absolute inset-0 section-backdrop"></div>
  </div>

  <div class="container-wide relative space-y-8">
    <div class="space-y-3">
      <p class="pill w-fit text-[11px] tracking-[0.2em]">{data.eyebrow}</p>
      <h2 class="h-section text-(--charcoal)">{data.title}</h2>
      <p class="section-lede max-w-3xl">{data.description}</p>
    </div>

    <div class="grid gap-8 xl:grid-cols-2">
      {
        doctors.map(({ doctor, asset }, idx) => (
          <article
            class="relative overflow-hidden rounded-[28px] border border-white/40 bg-white/40 shadow-[0_20px_60px_-40px_rgba(0,0,0,0.35)] backdrop-blur-[3px] reveal-on-scroll"
            data-reveal
            data-reveal-delay={`${idx * 180}ms`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-[1.45fr_1fr]">
              <div class="relative min-h-110 overflow-hidden lg:min-h-130">
                {asset ? (
                  <Image
                    src={asset}
                    alt={`Foto de ${doctor.name}`}
                    widths={[400, 560, 760, 900]}
                    sizes="(min-width: 1280px) 40vw, (min-width: 1024px) 55vw, 92vw"
                    loading="lazy"
                    decoding="async"
                    class:list={{
                      "absolute inset-0 h-full w-full object-cover object-center": true,
                      "scale-[1.28]": doctor.photo.includes("doctor.webp"),
                    }}
                  />
                ) : (
                  <img
                    src={doctor.photo}
                    alt={`Foto de ${doctor.name}`}
                    loading="lazy"
                    decoding="async"
                    width="900"
                    height="1200"
                    class="absolute inset-0 h-full w-full object-cover object-center"
                  />
                )}
                <span class="absolute left-4 top-4 rounded-full bg-[rgba(0,0,0,0.35)] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-white/90 backdrop-blur">
                  {doctor.badge}
                </span>
                <div class="absolute inset-x-0 bottom-0 h-44 bg-linear-to-t from-black/70 via-black/30 to-transparent" />
                <div class="absolute inset-x-0 bottom-0 p-5 text-white drop-shadow-[0_10px_26px_rgba(0,0,0,0.35)]">
                  <h3 class="h-card text-(--gold)">{doctor.name}</h3>
                  <p class="text-sm text-white/80">{doctor.subtitle}</p>
                </div>
              </div>

              <div class="flex h-full flex-col gap-4 bg-transparent p-4 lg:p-5">
                <div class="rounded-[22px] bg-[rgba(201,181,151,0.9)] p-6 text-(--charcoal) shadow-[0_14px_30px_-20px_rgba(0,0,0,0.25)]">
                  <p class="text-sm font-semibold text-(--charcoal)/80">
                    {data.experienceLabel}
                  </p>
                  <p class="font-(--font-heading) text-4xl leading-none text-(--charcoal)">
                    {doctor.experienceYears}
                  </p>
                  <p class="text-[11px] uppercase tracking-[0.18em] text-(--charcoal)/65">
                    {data.experienceSuffix}
                  </p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {doctor.tags.map((tag) => (
                      <span class="rounded-full border border-[rgba(176,128,80,0.35)] bg-white/60 px-3 py-1 text-xs font-semibold text-(--charcoal) shadow-[0_10px_24px_rgba(0,0,0,0.12)]">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="rounded-[22px] bg-white/90 p-6 text-(--charcoal) shadow-[0_18px_42px_-26px_rgba(0,0,0,0.24)] ring-1 ring-[rgba(32,32,32,0.06)]">
                  <ul class="space-y-2 text-sm text-(--charcoal)/85">
                    {doctor.bullets.map((item) => (
                      <li class="flex gap-2">
                        <span
                          aria-hidden="true"
                          class="mt-1 h-2 w-2 shrink-0 rounded-full bg-(--goldLight)"
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
